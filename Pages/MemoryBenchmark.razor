@page "/memory-benchmark"
@using System.Threading
@using System.Diagnostics
@using Client.Components

<PageTitle>Memory Benchmark</PageTitle>

<div class="benchmark-header">
    <h1>Memory & Data Stress</h1>
    <p>Massive array allocations and concurrent sorting on background threads.</p>
</div>

<div class="benchmark-grid">
    <div class="control-panel">
        <div class="input-group">
            <label>Concurrent Workers: @workerCount</label>
            <input type="range" min="1" max="8" @bind="workerCount" @bind:event="oninput" />
        </div>
        
        <div class="input-group">
            <label>Array Size (elements): @arraySize.ToString("N0")</label>
            <input type="number" @bind="arraySize" step="100000" />
        </div>

        <button class="primary-button" @onclick="StartBenchmark" disabled="@isRunning">
            @if (isRunning) { <span>Running...</span> } else { <span>Start Benchmark</span> }
        </button>
    </div>

    <div class="stats-panel">
        <SmoothnessVisualizer />
        
        <div class="metric">
            <label>Total Allocated:</label>
            <span class="value">@((totalAllocatedMB).ToString("F0")) MB</span>
        </div>
        
        <div class="metric">
            <label>Items Sorted:</label>
            <span class="value">@totalSorted.ToString("N0")</span>
        </div>

        <div class="progress-container">
            <div class="progress-bar" style="width: @(progress)%"></div>
        </div>
    </div>
</div>

<div class="worker-grid">
    @foreach (var status in workerStatuses)
    {
        <div class="worker-card @(status.IsActive ? "active" : "")">
            <div class="worker-info">
                <span>Worker #@status.Id</span>
                <span class="status-tag">@status.CurrentAction</span>
            </div>
            <div class="mini-bar-container">
                <div class="mini-bar" style="width: @(status.Progress)%"></div>
            </div>
        </div>
    }
</div>

<style>
    .benchmark-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .control-panel, .stats-panel {
        background: #1a1a1a;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #333;
    }

    .worker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
    }

    .worker-card {
        background: #222;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #333;
    }

    .worker-card.active {
        border-color: #f06292;
    }

    .worker-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.9rem;
    }

    .status-tag {
        color: #f06292;
        font-weight: bold;
    }

    .mini-bar-container {
        height: 4px;
        background: #111;
        border-radius: 2px;
    }

    .mini-bar {
        height: 100%;
        background: #f06292;
        transition: width 0.3s;
    }
</style>

@code {
    private int workerCount = 2;
    private int arraySize = 1_000_000;
    private bool isRunning = false;
    private double progress = 0;
    private long totalSorted = 0;
    private double totalAllocatedMB = 0;
    private List<WorkerStatus> workerStatuses = new();

    private class WorkerStatus
    {
        public int Id { get; set; }
        public double Progress { get; set; }
        public bool IsActive { get; set; }
        public string CurrentAction { get; set; } = "Idle";
    }

    private async Task StartBenchmark()
    {
        isRunning = true;
        totalSorted = 0;
        totalAllocatedMB = 0;
        workerStatuses.Clear();
        for (int i = 0; i < workerCount; i++) workerStatuses.Add(new WorkerStatus { Id = i });

        var tasks = new List<Task>();
        for (int i = 0; i < workerCount; i++)
        {
            int index = i;
            tasks.Add(Task.Run(() => RunWorker(index)));
        }

        while (isRunning)
        {
            progress = workerStatuses.Average(s => s.Progress);
            if (workerStatuses.All(s => !s.IsActive)) isRunning = false;
            StateHasChanged();
            await Task.Delay(100);
        }

        await Task.WhenAll(tasks);
        isRunning = false;
        StateHasChanged();
    }

    private void RunWorker(int index)
    {
        var status = workerStatuses[index];
        status.IsActive = true;
        
        try 
        {
            status.CurrentAction = "Allocating";
            status.Progress = 10;
            var data = new int[arraySize];
            totalAllocatedMB += (arraySize * 4) / (1024.0 * 1024.0);
            
            status.CurrentAction = "Filling";
            var rnd = new Random(index);
            for (int i = 0; i < arraySize; i++)
            {
                data[i] = rnd.Next();
                if (i % 50000 == 0) status.Progress = 10 + (i / (double)arraySize * 40);
            }

            status.CurrentAction = "Sorting";
            Array.Sort(data);
            status.Progress = 90;
            
            Interlocked.Add(ref totalSorted, arraySize);
            
            status.CurrentAction = "Done";
            status.Progress = 100;
        }
        finally
        {
            status.IsActive = false;
        }
    }
}
