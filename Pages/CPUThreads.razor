@page "/cpu-benchmark"
@using System.Threading
@using System.Diagnostics
@using Client.Components

<PageTitle>CPU Benchmark</PageTitle>

<div class="benchmark-header">
    <h1>CPU Multithreading</h1>
    <p>Calculating prime numbers across multiple threads.</p>
</div>

<div class="benchmark-grid">
    <div class="control-panel">
        <div class="input-group">
            <label>Thread Count: @threadCount</label>
            <input type="range" min="1" max="16" @bind="threadCount" @bind:event="oninput" />
        </div>
        
        <div class="input-group">
            <label>Numbers to check per thread: @numbersToProcess.ToString("N0")</label>
            <input type="number" @bind="numbersToProcess" />
        </div>

        <button class="primary-button" @onclick="StartBenchmark" disabled="@isRunning">
            @if (isRunning) { <span>Running...</span> } else { <span>Start Benchmark</span> }
        </button>
    </div>

    <div class="stats-panel">
        <SmoothnessVisualizer />
        
        <div class="metric">
            <label>Total Primes Found:</label>
            <span class="value">@totalPrimesFound.ToString("N0")</span>
        </div>
        
        <div class="metric">
            <label>Elapsed Time:</label>
            <span class="value">@elapsedTime.TotalSeconds.ToString("F2")s</span>
        </div>

        <div class="progress-container">
            <div class="progress-bar" style="width: @(progress)%"></div>
        </div>
    </div>
</div>

<div class="thread-visualizers">
    @foreach (var status in threadStatuses)
    {
        <div class="thread-card @(status.IsActive ? "active" : "")">
            <div class="thread-id">Thread #@status.Id</div>
            <div class="thread-progress">@status.Progress.ToString("F1")%</div>
            <div class="mini-bar-container">
                <div class="mini-bar" style="width: @(status.Progress)%"></div>
            </div>
        </div>
    }
</div>

<style>
    .benchmark-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .control-panel, .stats-panel {
        background: #1a1a1a;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #333;
    }

    .input-group {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .primary-button {
        width: 100%;
        padding: 12px;
        background: #00d2ff;
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .primary-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .metric {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .metric .value {
        font-family: 'JetBrains Mono', monospace;
        color: #00d2ff;
        font-size: 1.2rem;
    }

    .progress-container {
        height: 6px;
        background: #333;
        border-radius: 3px;
        margin-top: 20px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: #00d2ff;
        transition: width 0.1s;
    }

    .thread-visualizers {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
    }

    .thread-card {
        background: #222;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #333;
        transition: border-color 0.2s;
    }

    .thread-card.active {
        border-color: #00d2ff;
    }

    .mini-bar-container {
        height: 4px;
        background: #111;
        margin-top: 10px;
        border-radius: 2px;
    }

    .mini-bar {
        height: 100%;
        background: #00d2ff;
    }
</style>

@code {
    private int threadCount = 4;
    private long numbersToProcess = 500_000;
    private bool isRunning = false;
    private long totalPrimesFound = 0;
    private double progress = 0;
    private TimeSpan elapsedTime = TimeSpan.Zero;
    private List<ThreadStatus> threadStatuses = new();

    private class ThreadStatus
    {
        public int Id { get; set; }
        public double Progress { get; set; }
        public bool IsActive { get; set; }
        public int PrimesFound { get; set; }
    }

    private async Task StartBenchmark()
    {
        isRunning = true;
        totalPrimesFound = 0;
        progress = 0;
        threadStatuses.Clear();
        for (int i = 0; i < threadCount; i++) threadStatuses.Add(new ThreadStatus { Id = i });

        var sw = Stopwatch.StartNew();

        var tasks = new List<Task>();
        for (int i = 0; i < threadCount; i++)
        {
            int index = i;
            tasks.Add(Task.Run(() => RunThreadBenchmark(index)));
        }

        // Start a UI update loop
        var uiTask = Task.Run(async () => {
            while (isRunning)
            {
                elapsedTime = sw.Elapsed;
                UpdateAggregateProgress();
                await InvokeAsync(StateHasChanged);
                await Task.Delay(50);
            }
        });

        await Task.WhenAll(tasks);
        
        sw.Stop();
        elapsedTime = sw.Elapsed;
        isRunning = false;
        UpdateAggregateProgress();
        StateHasChanged();
    }

    private void UpdateAggregateProgress()
    {
        progress = threadStatuses.Average(s => s.Progress);
        totalPrimesFound = threadStatuses.Sum(s => (long)s.PrimesFound);
    }

    private void RunThreadBenchmark(int index)
    {
        var status = threadStatuses[index];
        status.IsActive = true;
        
        int found = 0;
        long start = index * numbersToProcess;
        long end = (index + 1) * numbersToProcess;

        for (long n = start; n < end; n++)
        {
            if (IsPrime(n))
            {
                found++;
            }

            if (n % 1000 == 0)
            {
                status.Progress = (double)(n - start) / numbersToProcess * 100;
                status.PrimesFound = found;
            }
        }

        status.Progress = 100;
        status.PrimesFound = found;
        status.IsActive = false;
    }

    private bool IsPrime(long number)
    {
        if (number <= 1) return false;
        if (number == 2) return true;
        if (number % 2 == 0) return false;

        var boundary = (long)Math.Floor(Math.Sqrt(number));

        for (long i = 3; i <= boundary; i += 2)
        {
            if (number % i == 0) return false;
        }

        return true;
    }
}
